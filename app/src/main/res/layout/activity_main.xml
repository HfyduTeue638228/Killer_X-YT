<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Main App Container (WindowInsets padding applied cleanly in MainActivity for Android 15 / HyperOS) -->
    <LinearLayout
        android:id="@+id/appContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Sleek Dedicated Killer X YT Header Bar (No browser URL bar!) -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/bar_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivBrandLogo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Killer X YT Logo"
                android:src="@drawable/ic_killerx_logo" />

            <TextView
                android:id="@+id/tvBrandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Killer X YT"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dark_pill"
                android:gravity="center"
                android:text="◀"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dark_pill"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="PiP"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBgPlay"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dark_pill"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="BG"
                android:textColor="@color/green_active"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShield"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_shield_pill"
                android:gravity="center"
                android:minWidth="40dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="🛡0"
                android:textColor="@color/killer_red_glow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_red_pill"
                android:gravity="center"
                android:text="CC"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="@color/killer_red"
            android:visibility="gone" />

        <!-- Custom Background-Play-Capable WebView -->
        <com.killerx.yt.KillerXWebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Native Sinhala Subtitle Overlay (Visible in Normal, Fullscreen, AND PiP!) -->
    <LinearLayout
        android:id="@+id/subtitleOverlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_subtitle"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOrigSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#D4D6E2"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSinhalaSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
