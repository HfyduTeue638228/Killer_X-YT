{
  "manifest_version": 2,
  "name": "Killer X YT Built-In Engine",
  "version": "2.0",
  "description": "Ad-Free YouTube + 0ms Sinhala CC (YT Package Mode) + Background Play + PiP for Killer X YT.",
  "browser_specific_settings": {
    "gecko": {
      "id": "killerx@killerx.yt"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}